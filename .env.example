# Core configuration
# Modeltaps reads configuration from the environment (via viper AutomaticEnv).
# SESSION_SECRET and USER_TOKEN_SECRET should be set to long random strings in
# production; if left unset, a random value is generated on each start, which
# invalidates existing sessions/tokens on restart.

# Random string used to sign session cookies. Required in production.
SESSION_SECRET=<change-me-to-a-random-string>
# Random string (32+ chars) used to sign user tokens. Required in production.
USER_TOKEN_SECRET=<change-me-to-a-32-char-random-string>
# Salt used to obfuscate generated IDs (hashids/sqids). Optional.
HASHIDS_SALT=<change-me-to-a-random-string>
# Initial root password, used ONLY on first startup when no user exists yet.
# Must be 8-64 characters (matches the User.Password validation range); the app
# fails to start if it is out of range. Leave unset to have a strong 16-char
# random password generated and printed once to the startup log instead of the
# old hardcoded "123456". Ignored once any user already exists in the database.
ROOT_PASSWORD=<change-me-to-an-8-to-64-char-password>
# Local development only: set to true to skip the 8-64 character check on
# ROOT_PASSWORD. The agreed local convention is ROOT_PASSWORD=root plus
# ROOT_PASSWORD_ALLOW_INSECURE=true, which seeds the root account as root/root.
# NEVER enable this in production. Leave unset for the production behaviour.
ROOT_PASSWORD_ALLOW_INSECURE=

# Database DSN for MySQL/PostgreSQL. Leave unset to use the bundled SQLite
# (modeltaps.db). Examples:
#   MySQL:      user:pass@tcp(localhost:3306)/modeltaps
#   PostgreSQL: postgres://user:pass@localhost:5432/modeltaps
SQL_DSN=
# Redis connection string for caching and rate-limiting. Leave unset to disable
# Redis. Example: redis://default:password@localhost:6379/0
REDIS_CONN_STRING=

# Provider OAuth credentials
# These are read at process start. Leave empty to disable the corresponding
# provider's built-in OAuth client (the provider then reports credentials as
# not configured). Populate with your own Google OAuth client values.

GEMINI_CLI_OAUTH_CLIENT_ID=<your-google-oauth-client-id>
GEMINI_CLI_OAUTH_CLIENT_SECRET=<your-google-oauth-client-secret>

ANTIGRAVITY_OAUTH_CLIENT_ID=<your-google-oauth-client-id>
ANTIGRAVITY_OAUTH_CLIENT_SECRET=<your-google-oauth-client-secret>

# Docker Compose deployment
# The base docker-compose.yml requires these to be set (it fails fast via
# ${VAR:?...} if any are missing). Copy this file to .env and fill in values.
# Generate strong random secrets, e.g.:
#   SESSION_SECRET / USER_TOKEN_SECRET : openssl rand -base64 32
#   MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD: openssl rand -base64 24

# Password for the dedicated MySQL user (compose user "modeltaps"). Also embedded
# into SQL_DSN by docker-compose.yml. Required by docker-compose.yml.
MYSQL_PASSWORD=<change-me-to-a-strong-random-password>
# Password for the MySQL root user. Required by docker-compose.yml.
MYSQL_ROOT_PASSWORD=<change-me-to-a-strong-random-password>
# Gin runtime mode for the app container. Non-secret; defaults to "release".
GIN_MODE=release
