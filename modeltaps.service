# File path: /etc/systemd/system/modeltaps.service
# sudo systemctl daemon-reload
# sudo systemctl start modeltaps
# sudo systemctl enable modeltaps
# sudo systemctl status modeltaps
[Unit]
Description=Modeltaps Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/modeltaps  # 注意修改路径
ExecStart=/path/to/modeltaps/modeltaps --port 3000 --log-dir /path/to/modeltaps/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
