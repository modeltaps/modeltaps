# 文档站 Cloudflare Pages 直传部署凭据模板。
# 复制为 .env.deploy 后填入真实值；.env.deploy 已被 .gitignore 忽略，切勿提交。
#
#   cp .env.deploy.example .env.deploy

# Cloudflare API Token。
# 控制台 → My Profile → API Tokens → Create Token，权限需要两条：
#   Account / Cloudflare Pages / Edit
#   Zone / DNS / Edit（资源限定 modeltaps.com zone，
#   用于绑定 docs.modeltaps.com 自定义域名时自动创建 DNS 记录）
CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID。控制台任意域名概览页右侧可见。
CLOUDFLARE_ACCOUNT_ID=

# Pages 项目名，需与控制台中的项目一致。
CF_PAGES_PROJECT=modeltaps-docs

# 部署目标分支。Pages 的 production branch 之外的值会发布为 preview。
CF_PAGES_BRANCH=main

# 文档站自定义域名，仅用于部署完成后的提示输出。
DOCS_DOMAIN=docs.modeltaps.com
