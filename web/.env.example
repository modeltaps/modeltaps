# Frontend branding (consumed by Vite at build time)
VITE_APP_NAME=Modeltaps
VITE_APP_DESCRIPTION=One key. Every model.
VITE_BRAND_DIR=brand

# Dev/preview only: target backend for the /api proxy in vite.config.mjs.
# Set this in web/.env.local when the backend runs on a non-default port.
# Production serves same-origin, so it is not needed there. Default: http://127.0.0.1:3000
# VITE_PROXY_TARGET=http://127.0.0.1:3000

# Extra dev-server hostnames (comma-separated), e.g. this machine's bare name for LAN preview
# VITE_ALLOWED_HOSTS=
